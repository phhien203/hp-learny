# ==========================================
# Database (Drizzle / Neon PostgreSQL)
# ==========================================
# Use the pooled connection for application queries and the direct connection for migrations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pet_lms?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.region.aws.neon.tech/pet_lms?sslmode=require"

# ==========================================
# Authentication (Clerk)
# ==========================================
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# ==========================================
# User Access & Roles
# ==========================================
# Comma-separated list of Clerk User IDs with teacher permissions
TEACHER_USER_IDS="user_xxx,user_yyy"
# Set to 'true' to restrict application access to whitelisted emails
ENABLE_WHITELIST="false"
# Comma-separated list of emails allowed when whitelist is enabled
USER_EMAIL_WHITELIST="user1@example.com,user2@example.com"

# ==========================================
# Stripe (Payments & Webhooks)
# ==========================================
STRIPE_API_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==========================================
# Bunny.net Stream (Video Management)
# ==========================================
BUNNY_LIBRARY_ID="your_bunny_library_id"
BUNNY_API_KEY="your_bunny_api_key"
BUNNY_TOKEN="your_bunny_token_authentication_key"
BUNNY_VIDEO_EXPIRES_SECONDS=600
BUNNY_UPLOAD_URL="https://video.bunnycdn.com/library"

# ==========================================
# Bunny.net Storage (File Uploads & CDN)
# ==========================================
BUNNY_STORAGE_API_KEY="your_bunny_storage_access_key"
BUNNY_FILE_UPLOAD_URL="https://storage.bunnycdn.com/your-storage-zone-name"
BUNNY_CDN_URL="https://your-pull-zone-hostname.b-cdn.net"
